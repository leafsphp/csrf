{
    "name": "leafs/csrf",
    "description": "Leaf CSRF security patch for leaf anchor",
    "keywords": [
        "util",
        "leaf",
        "php",
        "framework"
    ],
    "homepage": "https://leafphp.netlify.app/#/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Darko",
            "email": "mickdd22@gmail.com",
            "homepage": "https://mychi.netlify.app",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Leaf\\Anchor\\": "src"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "leafs/anchor": "*",
        "leafs/http": "*",
        "leafs/session": "*"
    },
    "require-dev": {
        "leafs/alchemy": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.68"
    },
    "scripts": {
        "alchemy": "./vendor/bin/alchemy setup",
        "test": "./vendor/bin/alchemy setup --test",
        "lint": "./vendor/bin/alchemy setup --lint",
        "actions": "./vendor/bin/alchemy setup --actions"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
